# Teaching Agent configuration — copy to .env and fill in.
# .env is git-ignored and holds local-only values.

# The agent's display name in Discord. Rename freely across the project's
# lifetime — this value is the ONLY place the name lives.
# "Alvar": after the Alvar method (edge-of-understanding teaching) in docs/thesis.md.
TEACHING_AGENT_NAME=Alvar

# The Discord channel this agent claims (your #learning channel).
DISCORD_CHANNEL_ID=<your-discord-channel-id>

# Your Discord user ID — only this user's messages are answered.
# (Right-click your avatar in Discord with developer mode on → Copy User ID,
# or copy the value from socratic-partner's .env.)
DISCORD_ALLOWED_USER_ID=<your-discord-account-user-id>

# discord-hub API location.
TEACHING_AGENT_HUB_URL=http://localhost:8100

# This agent's callback endpoint (receives inbound messages/commands from the hub).
# Port 9200 to avoid colliding with socratic-partner's 9100.
TEACHING_AGENT_CALLBACK_HOST=127.0.0.1
TEACHING_AGENT_CALLBACK_PORT=9200
# TEACHING_AGENT_CALLBACK_URL=   # override only if not localhost

# Optional avatar for the agent's webhook identity in Discord.
# Default: the committed assets/avatar.png served from the repo's raw URL.
TEACHING_AGENT_AVATAR_URL=https://raw.githubusercontent.com/Merced3/teaching-agent/main/assets/avatar.png

# Test mode: when true, the teacher NEVER writes to the knowledge base
# (docs/, maps/, sessions/, lessons/). Turn false for real sessions.
TEACHING_AGENT_TEST_MODE=true

# Unprompted recall pings (thesis H5) — OFF by default per the project spine.
# Flip to true only after a manual test, at low frequency.
TEACHING_AGENT_RECALL_PINGS_ENABLED=false
TEACHING_AGENT_RECALL_CHECK_INTERVAL_SECONDS=3600

# Pi (the teacher brain). Model follows your pi/OpenRouter setup; leave
# TEACHING_AGENT_PI_MODEL empty to use pi's configured default.
TEACHING_AGENT_PI_EXECUTABLE=pi
TEACHING_AGENT_PI_SESSION_DIRECTORY=data/pi-sessions
# TEACHING_AGENT_PI_MODEL=openrouter/anthropic/claude-sonnet-4.5
TEACHING_AGENT_PI_TIMEOUT_SECONDS=300
# Where the active lesson-thread binding persists (lessons can span days and
# restarts). Operational state, not knowledge — never in the knowledge base.
TEACHING_AGENT_LESSON_STATE_FILE=data/lesson-state.json

# Root of the knowledge base (this repo). Defaults to the current directory.
# TEACHING_AGENT_KNOWLEDGE_ROOT=.

TEACHING_AGENT_LOG_LEVEL=INFO

# ---- Voice (full-duplex conversation over discord-hub's /voice/stream) ----
# STT → pi (same session as text) → TTS, with barge-in interruption.
# Providers are swappable live from Discord:
#   /voice action:stt|tts value:<name>   /voice action:voice value:<voice-id>
#   /voice action:model value:<provider/model-id>   /voice action:start|stop|status
TEACHING_AGENT_VOICE_ENABLED=false
# Transport: how the agent reaches your ears. "discord" = discord-hub
# voice channel (auto-join, remote-PTT side channel below). "bridge" =
# voice-bridge phone page: no channel to join (/voice action:start just
# works), press/release edges arrive inside the stream, and the remote
# PTT button is unused. Everything else (STT/TTS/pi) is unchanged.
TEACHING_AGENT_VOICE_TRANSPORT=discord
# voice-bridge base URL (only used when TRANSPORT=bridge).
TEACHING_AGENT_VOICE_BRIDGE_URL=http://localhost:8200
# Auto-join whatever voice channel you enter (and leave when you leave).
# Discord transport only.
# Post a 🎙 transcript of each spoken exchange to the text channel.
TEACHING_AGENT_VOICE_POST_TRANSCRIPT=true
# "Thinking" filler clips ("Mm.") played while pi composes a reply, so
# dead air reads as "wait" instead of "dead". Generate once with
# tools/make_filler_audio.py; missing folder = fillers silently off.
TEACHING_AGENT_VOICE_FILLER_DIR=out/fillers
# Turn-taking tip: enable Discord push-to-talk. Releasing the key tells
# the agent "I'm done" exactly — no silence-guessing, no interruptions
# while you formulate. (Deepgram endpointing remains as the fallback.)

# Ears — https://console.deepgram.com/signup (free tier covers testing)
TEACHING_AGENT_VOICE_STT=deepgram
DEEPGRAM_API_KEY=

# Voice — https://elevenlabs.io/ (voice library has Jarvis-style voices;
# the voice id is the ONLY place the sound lives — swap it live with /voice)
TEACHING_AGENT_VOICE_TTS=elevenlabs
TEACHING_AGENT_VOICE_TTS_VOICE_ID=
TEACHING_AGENT_VOICE_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_API_KEY=

# Remote push-to-talk button (phone web page at /ptt, e.g.
# http://<your-pc>:9200/ptt?token=...). Discord transport only — the
# voice-bridge transport carries press/release inside the voice stream.
# While the button's heartbeat is
# fresh, press/release draws turn boundaries exactly; when it lapses the
# agent falls back to auto (speaking-event) detection. Requires the
# callback server reachable from the phone: set
# TEACHING_AGENT_CALLBACK_HOST=0.0.0.0 and use Tailscale off-LAN.
TEACHING_AGENT_VOICE_PTT_TOKEN=
